# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Banco Postgres. Local: postgres://financas:financas@localhost:5432/financas
# Supabase: use a "Connection string" do pooler (Project Settings > Database).
DATABASE_URL=postgres://financas:financas@localhost:5432/financas

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=

# Usuários criados pelo `npm run db:seed` (as senhas só são usadas para gerar o hash).
GUILHERME_EMAIL=
GUILHERME_SENHA=
DEBORA_EMAIL=
DEBORA_SENHA=
